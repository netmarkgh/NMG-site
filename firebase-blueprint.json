{
  "entities": {
    "Onboarding": {
      "title": "Onboarding Submission",
      "description": "Details from the onboarding form submitted by businesses.",
      "type": "object",
      "properties": {
        "bizName": { "type": "string", "description": "Name of the business" },
        "ownerName": { "type": "string", "description": "Full name of the owner" },
        "phone": { "type": "string", "description": "WhatsApp contact number" },
        "email": { "type": "string", "description": "Email address" },
        "industry": { "type": "string", "description": "Business industry" },
        "location": { "type": "string", "description": "Business location" },
        "website": { "type": "string", "description": "Most active online page link" },
        "services": { "type": "array", "items": { "type": "string" }, "description": "List of services requested" },
        "currentMkt": { "type": "string", "description": "Current marketing situation" },
        "budget": { "type": "string", "description": "Monthly budget range" },
        "goals": { "type": "array", "items": { "type": "string" }, "description": "Business goals" },
        "target": { "type": "string", "description": "Target customer description" },
        "bizDesc": { "type": "string", "description": "Detailed business description" },
        "scale": { "type": "number", "description": "Online presence rating (1-10)" },
        "extra": { "type": "string", "description": "Additional notes" },
        "ghanaFrontUrl": { "type": "string", "description": "URL to Ghana Card Front image" },
        "ghanaBackUrl": { "type": "string", "description": "URL to Ghana Card Back image" },
        "personalPicUrl": { "type": "string", "description": "URL to personal HD photo" },
        "logoUrl": { "type": "string", "description": "URL to logo or brand assets" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Timestamp of submission" }
      },
      "required": ["bizName", "ownerName", "phone", "email", "industry", "location", "website", "services", "currentMkt", "budget", "goals", "target", "bizDesc", "scale", "extra"]
    }
  },
  "firestore": {
    "/onboarding/{onboardingId}": {
      "schema": "Onboarding",
      "description": "Public onboarding submissions"
    }
  }
}
